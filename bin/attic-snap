#!/usr/bin/env bash
# attic-snap — keep a copy of a file before something overwrites it.
#
#   attic-snap <file>...                    snapshot one or more files
#   attic-snap --list <file>                show stored versions of a file
#   attic-snap --restore <version> <file>   put an old version back
#   attic-snap --root                       print the resolved working root
#
# One copy per distinct content: the stored name carries a UTC timestamp and
# the first 8 characters of the SHA-1, and re-running on unchanged bytes is a
# no-op. That makes it safe to call on every write without accumulating noise.
#
# Nothing is ever pruned automatically. See docs/scope.md for what this does
# and, more importantly, what it does not do.
set -euo pipefail

# --- Resolving the working root -----------------------------------------
# In order: an explicit ATTIC_ROOT, a directory marked with .attic-root or an
# existing .attic, then the git top level. Explicit beats implicit, and a
# marker file beats git so a repo can hold several independent roots.
resolve_root() {
  if [ -n "${ATTIC_ROOT:-}" ]; then
    [ -d "$ATTIC_ROOT" ] || { echo "attic: ATTIC_ROOT is not a directory: $ATTIC_ROOT" >&2; exit 2; }
    (cd "$ATTIC_ROOT" && pwd); return
  fi
  local d; d=$(pwd)
  while [ "$d" != "/" ]; do
    if [ -e "$d/.attic-root" ] || [ -d "$d/.attic" ]; then printf '%s' "$d"; return; fi
    d=$(dirname "$d")
  done
  if d=$(git rev-parse --show-toplevel 2>/dev/null); then printf '%s' "$d"; return; fi
  echo "attic: no working root found. Set ATTIC_ROOT, or create .attic-root in the directory you want to be the root." >&2
  exit 2
}

ROOT=$(resolve_root)
ATTIC="${ATTIC_DIR:-$ROOT/.attic}"
MAX_BYTES="${ATTIC_MAX_BYTES:-$((10 * 1024 * 1024))}"

# Paths that are never worth storing: the store itself, dependency trees,
# build output, temp space, and editor lock files.
skip_path() {
  case "$1" in
    "$ATTIC"/*|*/.attic/*|*.attic) return 0 ;;
    */node_modules/*|*/.venv/*|*/venv/*|*/site-packages/*|*/.git/*) return 0 ;;
    */target/*|*/dist/*|*/build/*|*/__pycache__/*) return 0 ;;
    /tmp/*|/var/tmp/*|/private/tmp/*|/var/folders/*) return 0 ;;
    *~\$*|*.swp|*.swo|*~) return 0 ;;
  esac
  # Anything the user marked as ignorable.
  if [ -n "${ATTIC_EXCLUDE:-}" ]; then
    local pat
    while IFS= read -r pat; do
      [ -z "$pat" ] && continue
      # shellcheck disable=SC2254
      case "$1" in $pat) return 0 ;; esac
    done <<< "${ATTIC_EXCLUDE//:/$'\n'}"
  fi
  return 1
}

# .attic/<path mirrored from root>/<file name>/<UTC>.<hash8>.<ext>
# Files outside the root are mirrored under _external/ so they are covered too.
version_dir() {
  local abs="$1" rel
  case "$abs" in
    "$ROOT"/*) rel="${abs#"$ROOT"/}" ;;
    *)         rel="_external/${abs#/}" ;;
  esac
  printf '%s/%s' "$ATTIC" "$rel"
}

abs_path() {
  # Resolve without requiring the file, or even its directory, to exist:
  # --list and --restore must find versions of a file whose parent tree was
  # deleted, which is the recovery case the store exists for. The lexical
  # fallback is only ever used for lookups; snap_one requires an existing
  # file, so nothing stored ever goes through it.
  local d b p
  d=$(dirname -- "$1"); b=$(basename -- "$1")
  if p=$(cd -- "$d" 2>/dev/null && pwd); then
    printf '%s/%s' "$p" "$b"
  else
    case "$d" in
      /*) printf '%s/%s' "$d" "$b" ;;
      .)  printf '%s/%s' "$PWD" "$b" ;;
      *)  printf '%s/%s/%s' "$PWD" "$d" "$b" ;;
    esac
  fi
}

content_hash() {
  shasum -a 1 -- "$1" 2>/dev/null | cut -c1-8 \
    || sha1sum -- "$1" | cut -c1-8             # GNU coreutils fallback
}

# True when the store already holds these exact bytes for this file.
has_version() {
  find "$1" -maxdepth 1 -name "*.$2.*" -o -maxdepth 1 -name "*.$2" 2>/dev/null | grep -q .
}

snap_one() {
  local f="$1" abs vdir hash ext base stamp dest tmp
  [ -f "$f" ] || return 0                 # nothing to preserve
  [ -L "$f" ] && f=$(readlink -f -- "$f" 2>/dev/null || printf '%s' "$f")
  abs=$(abs_path "$f")
  if skip_path "$abs"; then
    # A skip is policy, but a silent one leaves the caller confidently
    # unprotected. Sweeps set ATTIC_SWEEP: dropping excluded trees without
    # a word is what a sweep is for, an explicit target is not.
    [ -n "${ATTIC_SWEEP:-}" ] || echo "attic: skipped (excluded path): $abs" >&2
    return 0
  fi

  local size; size=$(wc -c < "$abs" | tr -d ' ')
  if [ "$size" -gt "$MAX_BYTES" ]; then
    echo "attic: skipped (over ${MAX_BYTES} bytes): $abs" >&2; return 0
  fi
  [ "$size" -eq 0 ] && return 0           # empty: nothing to preserve

  vdir=$(version_dir "$abs")
  mkdir -p -- "$vdir"

  # Copy first, then hash the copy, then name it. Hashing the live file and
  # copying afterwards stores a mid-snapshot rewrite under the old hash, and
  # the dedupe below then refuses to ever store the old bytes again. The
  # final mv also means no other process sees a half-written version.
  tmp=$(mktemp "$vdir/.tmp.XXXXXX") || return 1
  if ! cp -p -- "$abs" "$tmp"; then rm -f -- "$tmp"; return 1; fi

  # Zero bytes is nothing to preserve, whether the file is genuinely empty
  # or was truncated mid-snapshot: the store never holds empty versions.
  # Checked on the copy, the only bytes that count.
  if [ ! -s "$tmp" ]; then rm -f -- "$tmp"; return 0; fi

  hash=$(content_hash "$tmp")

  # Content dedupe: these exact bytes are already stored.
  if has_version "$vdir" "$hash"; then rm -f -- "$tmp"; return 0; fi

  base=$(basename -- "$abs"); ext="${base##*.}"; [ "$ext" = "$base" ] && ext=""
  stamp=$(date -u +%Y-%m-%dT%H%M%SZ)
  if [ -n "$ext" ]; then dest="$vdir/$stamp.$hash.$ext"; else dest="$vdir/$stamp.$hash"; fi
  if ! mv -- "$tmp" "$dest"; then rm -f -- "$tmp"; return 1; fi
  echo "attic: $abs -> $dest"
}

case "${1:-}" in
  --root) printf '%s\n' "$ROOT" ;;
  --list)
    shift; [ $# -eq 1 ] || { echo "attic: --list takes one file" >&2; exit 1; }
    d=$(version_dir "$(abs_path "$1")")
    if [ -d "$d" ]; then ls -1t -- "$d"; else echo "no versions stored for $1"; fi ;;
  --restore)
    shift; [ $# -eq 2 ] || { echo "attic: --restore takes <version> <target>" >&2; exit 1; }
    src="$1"; target="$2"
    [ -f "$src" ] || { echo "attic: no such version: $src" >&2; exit 1; }
    # Never let a restore destroy the newer file. snap_one returns 0 on the
    # skips that are harmless elsewhere (exclusions, size cap), so its exit
    # status proves nothing here: check the store for the target's current
    # bytes and refuse to overwrite them if they are not actually there.
    # An empty target is nothing to destroy (and is never stored), so -s.
    if [ -s "$target" ]; then
      snap_one "$target"
      t="$target"
      [ -L "$t" ] && t=$(readlink -f -- "$t" 2>/dev/null || printf '%s' "$t")
      tabs=$(abs_path "$t")
      if ! has_version "$(version_dir "$tabs")" "$(content_hash "$tabs")"; then
        echo "attic: refusing to restore over $target: its current content is not in the store (excluded path, or over the size cap?)" >&2
        exit 1
      fi
    fi
    # Recreate a deleted parent: restoring a file whose tree is gone is the
    # recovery scenario, not an error.
    mkdir -p -- "$(dirname -- "$target")"
    cp -p -- "$src" "$target"; echo "attic: restored $src -> $target" ;;
  -h|--help|"")
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:+0}" ;;
  --*) echo "attic: unknown option: $1" >&2; exit 1 ;;
  *) for f in "$@"; do snap_one "$f"; done ;;
esac
